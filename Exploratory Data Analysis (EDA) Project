# ============================================
# EXPLORATORY DATA ANALYSIS (EDA) PROJECT
# Dataset Used: Titanic Dataset (Built-in from Seaborn)
# ============================================

# Import Libraries
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

# --------------------------------------------
# LOAD DATASET
# --------------------------------------------

# Titanic dataset is available directly in seaborn
df = sns.load_dataset("titanic")

# Display first 5 rows
print("\nFIRST 5 RECORDS")
print(df.head())

# --------------------------------------------
# BASIC INFORMATION
# --------------------------------------------

print("\nDATASET INFORMATION")
print(df.info())

print("\nDATASET SHAPE")
print(df.shape)

print("\nCOLUMN NAMES")
print(df.columns)

# --------------------------------------------
# CHECK MISSING VALUES
# --------------------------------------------

print("\nMISSING VALUES")
print(df.isnull().sum())

# --------------------------------------------
# STATISTICAL SUMMARY
# --------------------------------------------

print("\nSTATISTICAL SUMMARY")
print(df.describe())

# --------------------------------------------
# DATA CLEANING
# --------------------------------------------

# Fill missing age with median
df["age"] = df["age"].fillna(df["age"].median())

# Fill missing embarked values with mode
df["embarked"] = df["embarked"].fillna(df["embarked"].mode()[0])

# Drop deck column because too many missing values
df = df.drop(columns=["deck"])

print("\nMISSING VALUES AFTER CLEANING")
print(df.isnull().sum())

# --------------------------------------------
# UNIVARIATE ANALYSIS
# --------------------------------------------

# Age Distribution
plt.figure(figsize=(8,5))
sns.histplot(df["age"], bins=30, kde=True)
plt.title("Age Distribution")
plt.xlabel("Age")
plt.ylabel("Count")
plt.show()

# Gender Count
plt.figure(figsize=(6,4))
sns.countplot(x="sex", data=df)
plt.title("Gender Count")
plt.show()

# Passenger Class Count
plt.figure(figsize=(6,4))
sns.countplot(x="class", data=df)
plt.title("Passenger Class Distribution")
plt.show()

# --------------------------------------------
# BIVARIATE ANALYSIS
# --------------------------------------------

# Survival based on gender
plt.figure(figsize=(6,4))
sns.countplot(x="sex", hue="survived", data=df)
plt.title("Survival Based on Gender")
plt.show()

# Survival based on passenger class
plt.figure(figsize=(7,5))
sns.countplot(x="class", hue="survived", data=df)
plt.title("Survival Based on Passenger Class")
plt.show()

# Fare vs Age
plt.figure(figsize=(8,5))
sns.scatterplot(x="age", y="fare", hue="survived", data=df)
plt.title("Age vs Fare")
plt.show()

# --------------------------------------------
# CORRELATION ANALYSIS
# --------------------------------------------

# Select only numeric columns
numeric_df = df.select_dtypes(include=np.number)

# Correlation matrix
correlation = numeric_df.corr()

print("\nCORRELATION MATRIX")
print(correlation)

# Heatmap
plt.figure(figsize=(10,6))
sns.heatmap(correlation, annot=True, cmap="coolwarm")
plt.title("Correlation Heatmap")
plt.show()

# --------------------------------------------
# GROUP ANALYSIS
# --------------------------------------------

# Average fare by class
average_fare = df.groupby("class")["fare"].mean()

print("\nAVERAGE FARE BY CLASS")
print(average_fare)

# Survival rate by gender
survival_gender = df.groupby("sex")["survived"].mean()

print("\nSURVIVAL RATE BY GENDER")
print(survival_gender)

# --------------------------------------------
# INSIGHTS
# --------------------------------------------

print("\nPROJECT INSIGHTS")
print("1. Female passengers had a higher survival rate.")
print("2. First-class passengers survived more than third-class passengers.")
print("3. Fare and passenger class influenced survival.")
print("4. Most passengers were between 20 and 40 years old.")
print("5. Passenger class and fare are positively correlated.")

# --------------------------------------------
# SAVE CLEANED DATASET
# --------------------------------------------

df.to_csv("cleaned_titanic_dataset.csv", index=False)

print("\nCleaned dataset saved successfully.")
